{{- /* RSS for home, sections and tags: blog posts only (no About/Archives),
       newest first, in the page's language. */ -}}
{{- $source := cond .IsHome site.RegularPages .RegularPagesRecursive -}}
{{- if eq .Kind "term" }}{{ $source = .Pages }}{{ end -}}
{{- $posts := slice -}}
{{- range $source.ByDate.Reverse -}}
  {{- if partial "utils/is-post.html" . }}{{ $posts = $posts | append . }}{{ end -}}
{{- end -}}
{{- $posts = first (site.Config.Services.RSS.Limit | default 30) $posts -}}
{{- $updated := now -}}{{- with index $posts 0 }}{{ $updated = .Date }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ site.Title }} – {{ .Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.LanguageCode | default site.Language.Lang }}</language>
    <lastBuildDate>{{ $updated.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $posts }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- range .Params.tags }}
      <category>{{ . }}</category>
      {{- end }}
      <description>{{ with .Description }}{{ . }}{{ end }}{{ "\n" }}{{ .Content | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
